vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: down

title: "GDHUB-126 — every review reads the project through four lenses" {
  shape: text
  near: top-center
  style.font-size: 22
}

facts: "Checkpoint facts for a period\none collector, grouped by lens" {
  dev: "Development\nartifacts, devlogs, evidence check"
  mkt: "Marketing\npublic devlogs, applause, views,\nstore page and links"
  hr: "Team\nroles, levels, stated hours,\nweekly pulse, joined / left, openings"
  pm: "Project management\ntasks day 1 / day 15, closed by sprint,\nthe goal chain"
}

weights: "Lens weights per stage (app config)\nlow · normal · high\ne.g. Ideation: marketing low · Demo: marketing high"

moments: "Every review moment" {
  goal: "Day 1: goal check"
  advice: "Day 1 and day 15: plan advice"
  review: "Sprint reviews 1–3"
  brief: "Human curator's brief"
  verdict: "Verdict note"
}

facts -> moments: "same facts, the moment's own period"
weights -> moments: "how much each lens says"

out: "Four lens blocks" {
  author: "AI curator → the author\nReview tab"
  curator: "Human curator → the curator\nthe brief before a call"
}
moments -> out

critical: "Critical" {
  a: "The verdict is decided by the tasks and the goal; the lenses explain it"
  b: "Team is context: one open task is not a missing person; hours first, a new person last"
  c: "A low-weight lens is one line, never blamed for zeros it was not meant to have"
  d: "Development splits work within the tasks from work outside them"
}
