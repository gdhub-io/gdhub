vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: down

title: "GDHUB-90 — moving a call with the other side's approval, presence, the live timer" {
  shape: text
  near: top-center
  style.font-size: 22
}

move: "Moving a call (12.08.11–13)" {
  ask: "Author or curator: 'Move the call'\n(call card, or ⋮ on the session row)"
  pick: "Pick a time from the curator's free hours:\nany time in days 1–3 of the call's sprint\n(the final call: days 29–31)"
  pending: "Request waits · the old time stands\nthe other side is told"
  answer: "Other side answers" {shape: diamond}
  moved: "Call moved · both told · new calendar entry"
  kept: "Old time kept · the proposer is told"
  withdrawn: "Proposer withdraws"
  lapsed: "Room opens at the old time → request lapses"
  ask -> pick -> pending -> answer
  answer -> moved: "Move it"
  answer -> kept: "Keep"
  pending -> withdrawn
  pending -> lapsed
}

room: "Call room sidebar" {
  presence: "Team: who is in the call, who is away\n(asked from the video room while the call page is open)"
  timer: "Live · mm:ss — from the moment the curator joined"
  activity: "Activity feed — the curator reads it whenever they open the checkpoint"
}

critical: "Critical" {
  style.stroke: "#C0392B"
  a: "Moving is checked again on approval: the hour may have been taken meanwhile"
  b: "One open request per call; only the other side approves"
  c: "Only this call moves; the others keep their days"
  d: "Calls with a human curator only; never once the room has opened"
}

move.moved -> critical.a
