                      "type": "text",
                      "id": "VZv0W",
                      "fill": "$text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Your answers are an opinion, not a warranty. Teams decide for themselves and carry their own risk.",
