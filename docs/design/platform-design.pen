                  "fontSize": 11,
                  "fontWeight": "600",
                  "letterSpacing": 0.6
                },
                {
                  "type": "text",
                  "id": "v8lMiV",
                  "name": "H",
                  "fill": "$text-primary",
                  "content": "Volunteer advisor agreement",
                  "fontFamily": "$font",
                  "fontSize": 16,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "BtcFG",
                  "name": "P",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "1. You advise teams on the platform as a volunteer. Nothing here creates employment, a contractor relationship, a fee, equity or any other compensation.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Bbczh",
                  "name": "P",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "2. You choose which questions to take and can stop at any time. Nobody on the platform can oblige you to answer, meet a deadline or hold a call.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "JZ55D",
                  "name": "P",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "3. What a team shares with you in a request stays between you and them. You do not pass it on and you do not use it for a competing product.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "rHC82",
                  "name": "P",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "4. Your answers are an opinion, not a warranty. Teams decide for themselves and carry their own risk.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "q2pL3",
                  "name": "P",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "5. The platform may remove you from the experts catalogue if the rules above are broken.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
