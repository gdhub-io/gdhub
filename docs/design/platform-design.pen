                {
                  "type": "text",
                  "id": "a0DRG",
                  "name": "L",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The four sprint columns are fixed at 72 and never shrink — they are the reading. The name column is the only elastic one: at page width eight long names fit, and in the curator's 820 drawer, drawn here, the name truncates and the role under it truncates first. Eight members is the maximum the standard allows, so the block never scrolls.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
