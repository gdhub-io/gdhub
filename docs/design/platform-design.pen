              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "R782Cc",
                  "name": "SKILL LEVELS",
                  "fill": "#1A1917",
                  "content": "SKILL LEVELS",
                  "fontFamily": "Onest",
                  "fontSize": 11,
                  "fontWeight": "600",
                  "letterSpacing": 1.2
                },
                {
                  "type": "text",
                  "id": "BwgNa",
                  "name": "SkillLevel is an ord",
                  "fill": "#76756F",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "SkillLevel is an ordinal scale of five — a quantity, so it is drawn as one: five blocks filled to the level, in a single colour. Rank you can count needs no legend. The old five-hue ramp is retired: hue carries no order, and running it red → green told a Novice their level was an error state. Graphite carries the meter (--gd-color-text), the empty track is --gd-color-border-strong, and the label always travels with it — the blocks alone are a chart, not a word.",
                  "lineHeight": 1.5,
                  "fontFamily": "Onest",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "klPgw",
              "name": "Levels",
              "width": "fill_container",
              "gap": 16,
              "children": [
                {
                  "type": "frame",
