              "children": [
                {
                  "type": "text",
                  "id": "BmIVG",
                  "name": "Label",
                  "fill": "$text-tertiary",
                  "content": "THEME ARCHITECTURE — ONE TOKEN LAYER, TWO MODES, TWO DENSITIES",
                  "fontFamily": "$font",
                  "fontSize": 11,
                  "fontWeight": "600",
                  "letterSpacing": 1.2
                },
                {
                  "type": "text",
                  "id": "qn4Nj",
                  "name": "Note",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": 1000,
                  "content": "The three themes do not need to merge into one look — they need to stop being three independent definitions. Almost everything they disagree on today (fonts, radii, control heights, semantic colours) has no reason to differ. What legitimately differs is which neutral step plays 'surface' and how roomy the layout is. That is two variables, not three themes.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
