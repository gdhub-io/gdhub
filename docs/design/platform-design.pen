            },
            {
              "type": "frame",
              "id": "u8psn",
              "name": "Rule",
              "width": "fill_container",
              "gap": 8,
              "children": [
                {
                  "type": "icon",
                  "id": "FEQbu",
                  "name": "Ic",
                  "width": 14,
                  "height": 14,
                  "icon": "corner-down-right",
                  "library": "lucide",
                  "fill": "$text-tertiary"
                },
                {
                  "type": "text",
                  "id": "o1Bs0",
                  "name": "L",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A column width binds only under `table-layout: fixed`, which antd turns on once `scroll.x` is set — and `scroll.x: \"max-content\"` defeats truncation entirely, so both tables here pass a number.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "t0gmT",
              "name": "Rule",
              "width": "fill_container",
              "gap": 8,
              "children": [
                {
                  "type": "icon",
                  "id": "E6Fef",
                  "name": "Ic",
                  "width": 14,
                  "height": 14,
                  "icon": "corner-down-right",
                  "library": "lucide",
                  "fill": "$text-tertiary"
                },
                {
                  "type": "text",
                  "id": "mMJYg",
                  "name": "L",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Truncation inside a flex row needs `min-width: 0` on the parent; a flex item defaults to `min-width: auto` and refuses to shrink below its content, so the ellipsis simply never engages.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
