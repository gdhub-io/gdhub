      "children": [
        {
          "type": "frame",
          "id": "NSX0U",
          "name": "Header",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 10,
          "children": [
            {
              "type": "text",
              "id": "R1iWU",
              "name": "Title",
              "fill": "$text-primary",
              "content": "GDHub Design System — 07 / Proposal",
              "lineHeight": 1.2,
              "fontFamily": "$font",
              "fontSize": 32,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "t50Sa",
              "name": "Principle",
              "fill": "$text-secondary",
              "textGrowth": "fixed-width",
              "width": 1000,
              "content": "Neutral-first, brand-accented. Structure drops to 6–12% contrast, content keeps 90%, and #F15541 is spent only where the user must act. One family, one ramp, one ladder — the three themes become one theme with two surface modes.",
              "lineHeight": 1.6,
              "fontFamily": "$font",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "wKJrg",
              "name": "Status",
              "fill": "#12854B",
              "textGrowth": "fixed-width",
              "width": 1000,
              "content": "Implemented in src/config/design/ — tokens.ts · roles.ts · antd.ts · css.ts · fonts.ts, guarded by tests/design-system.test.ts. Wired: --gd-* variables and both fonts on <body>, productTheme in ProtectedShell, and the direction tint+ink pairs now feed DirectionBadge, VacancyCard, the talent pool and the specialist modal. Landing, public and auth shells still run the old themes.",
              "lineHeight": 1.5,
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "500"
            }
          ]
        },
        {
          "type": "frame",
          "id": "xT6OH",
          "name": "Section — Theme architecture",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 16,
          "children": [
            {
              "type": "frame",
              "id": "jUsAb",
