    {
      "type": "frame",
      "id": "cdYJm",
      "x": 7700,
      "y": 47700,
      "name": "Views — Range picker · 90-day bound",
      "clip": true,
      "fill": "$page-bg",
      "layout": "vertical",
      "gap": 12,
      "padding": 24,
