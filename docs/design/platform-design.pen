                  "fontWeight": "600",
                  "letterSpacing": 1.2
                },
                {
                  "type": "text",
                  "id": "nhSZk",
                  "name": "--gd-direction-<slug>-ti",
                  "fill": "#76756F",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "--gd-direction-<slug>-tint / -ink  ·  directionColors[slug] in tokens.ts for the colours, src/components/DirectionBadge/directions.ts for the icons — the two are joined there, so a direction without a colour pair is a compile error. Never hard-code either half: read it through getWorkDirection(name) or <IconTile direction=\"…\">. The encoding is double on purpose — colour and icon — so the eighteen stay apart for anyone who can't rely on hue. Tints share a lightness around L93; ink sits near L25, the tint's own hue pulled dark. Icons are @tabler/icons-react; the glyphs below are the closest lucide equivalents, because Pencil has no Tabler library — copy the Tabler name, not the shape.",
                  "lineHeight": 1.5,
                  "fontFamily": "Onest",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
