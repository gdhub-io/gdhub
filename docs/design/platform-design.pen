                    },
                    {
                      "type": "text",
                      "id": "O5wG1",
                      "name": "L",
                      "fill": "$text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The name truncates, the level never does — it is what the price is computed from. Full name in a tooltip, and in the picker, where there is room, it is not truncated at all.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font",
