        {
          "type": "frame",
          "id": "MJIC4",
          "name": "Section — Who we are",
          "clip": true,
          "width": "fill_container",
          "height": 1315,
          "fill": "$brand-primary",
          "layout": "none",
          "children": [
            {
              "type": "text",
              "id": "fvIsj",
              "x": 24,
              "y": 40,
              "name": "Pretitle",
              "fill": "$brand-accent",
              "textGrowth": "fixed-width",
              "width": 342,
              "content": "KNOW ABOUT US",
              "lineHeight": 1.5,
              "textAlign": "center",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "tD6FC",
              "x": 24,
              "y": 85,
              "name": "Title",
              "fill": "$inv-text",
              "textGrowth": "fixed-width",
              "width": 342,
              "content": "WHO WE ARE",
              "lineHeight": 1.2,
              "textAlign": "center",
              "fontFamily": "$font",
              "fontSize": 32,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "ASvqW",
              "x": 24,
              "y": 140,
              "name": "Subtitle",
              "fill": "$inv-text",
              "textGrowth": "fixed-width",
              "width": 342,
              "content": "We are a community of professionals from the gaming world who don’t want to be limited to traditional employment.",
              "lineHeight": 1.5,
              "textAlign": "center",
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal",
              "fontStyle": "italic"
            },
            {
              "type": "frame",
              "id": "bUUho",
              "x": 24,
              "y": 244,
              "name": "Story",
              "width": 342,
              "layout": "vertical",
              "gap": 14,
              "children": [
                {
                  "type": "text",
                  "id": "mR536",
                  "name": "Paragraph",
                  "fill": "$inv-text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "We started our journey in 2015 when we organized a game development incubator, where we trained and supported young developers, helping them to bring their ideas to life. Since then we have grown to become Gdhub - a unique platform that brings together experienced professionals from different areas of game development into dynamic and creative teams.",
                  "lineHeight": 1.5,
                  "textAlign": "justify",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "qDRgc",
                  "name": "Paragraph",
                  "fill": "$inv-text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "On Gdhub you can find partners to co-develop commercial video games, as well as share knowledge and experience with other members of the community.",
                  "lineHeight": 1.5,
                  "textAlign": "justify",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "JxAwN",
                  "name": "Paragraph",
                  "fill": "$inv-text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "We work in a gig economy - an economy of temporary and non-permanent work, which gives us flexibility and independence. We value freedom, creativity and the ability to choose interesting projects.",
                  "lineHeight": 1.5,
                  "textAlign": "justify",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
