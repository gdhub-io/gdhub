              "width": "fill_container",
              "layout": "vertical",
              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "kZNfZ",
                  "name": "NEUTRAL RAMP",
                  "fill": "#1A1917",
                  "content": "NEUTRAL RAMP",
                  "fontFamily": "Onest",
