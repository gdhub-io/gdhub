    {
      "type": "note",
      "id": "cuh4P",
      "x": -420,
      "y": 0,
      "name": "Row — Design System",
      "width": 300,
      "height": 320,
      "content": "Design System\n\nSource of truth for tokens, typography and cards. To the right: shared components reused across all contexts (space bar — breadcrumbs & switcher, multiselect dropdowns)."
    },
    {
      "type": "note",
      "id": "qB2fp",
      "x": -420,
      "y": 6773,
      "name": "Row — Landing",
      "width": 300,
      "height": 320,
      "content": "Landing\n\nPublic promo landing page. Desktop and mobile variant stacked."
    },
    {
      "type": "note",
      "id": "UWyQr",
      "x": -420,
      "y": 10555,
      "name": "Row — Hub — Catalogs",
      "width": 300,
      "height": 320,
      "content": "Hub — Catalogs\n\nPublic hub: projects, events, jobs, courses, talent pool. Mobile versions, skeletons and empty states are stacked below. Job Card component sits at the end of the row."
    },
    {
      "type": "note",
      "id": "Orl2o",
      "x": -420,
      "y": 14597,
      "name": "Row — Public Pages",
      "width": 300,
      "height": 320,
      "content": "Public Pages\n\nPublic detail pages: project, event, job, course, legal details and certificate verification. Mobile variants stacked below desktop. Main Footer component sits at the end of the row."
    },
    {
      "type": "note",
      "id": "MpQCk",
      "x": -420,
      "y": 20309,
      "name": "Row — People Cards",
      "width": 300,
      "height": 320,
      "content": "People Cards\n\nTalent and expert card modals plus popovers (project, certificate) and their variants."
    },
    {
      "type": "note",
      "id": "u2ybn",
      "x": -420,
      "y": 23669,
      "name": "Row — Project Space",
      "width": 300,
      "height": 320,
      "content": "Project Space\n\nProject workspace: project modal with all tabs (files, activities, reviews, workflow, team), workflow page and vacancy modals. Task Row component and its states sit at the end of the row."
    },
    {
      "type": "note",
      "id": "b8JhR",
      "x": -420,
      "y": 31009,
      "name": "Row — Course Space",
      "width": 300,
      "height": 320,
      "content": "Course Space\n\nCourse workspace: my courses, curriculum, cohorts, students, classroom, payments and settings. Related modals stacked under their pages."
    },
    {
      "type": "note",
      "id": "ufj7V",
      "x": -420,
      "y": 33259,
      "name": "Row — Scout Space",
      "width": 300,
      "height": 320,
      "content": "Scout Space\n\nScout workspace (paid users looking for early-stage games to invest in or publish): games and settings."
    },
    {
      "type": "note",
      "id": "flN9z",
      "x": -420,
      "y": 35059,
      "name": "Row — Event Space",
      "width": 300,
      "height": 320,
      "content": "Event Space\n\nEvent workspace: my events, schedule, content, members, settings per event type and schedule item modals."
    },
    {
      "type": "note",
      "id": "O9kFwC",
      "x": -420,
