          "children": [
            {
              "type": "text",
              "id": "xRoIW",
              "x": 64,
              "y": 64,
              "name": "Pretitle",
              "fill": "$brand-accent",
              "textGrowth": "fixed-width",
              "width": 1312,
              "content": "KNOW ABOUT US",
              "lineHeight": 1.5,
              "textAlign": "center",
              "fontFamily": "$font",
              "fontSize": 16,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "qVdN1",
              "x": 64,
              "y": 128,
              "name": "Title",
              "fill": "$inv-text",
              "textGrowth": "fixed-width",
              "width": 1312,
              "content": "WHO WE ARE",
              "lineHeight": 1.2,
              "textAlign": "center",
              "fontFamily": "$font",
              "fontSize": 48,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "Nueki",
              "x": 470,
              "y": 212,
              "name": "Subtitle",
              "fill": "$inv-text",
              "textGrowth": "fixed-width",
              "width": 500,
              "content": "We are a community of professionals from the gaming world who don’t want to be limited to traditional employment.",
              "lineHeight": 1.5,
              "textAlign": "center",
              "fontFamily": "$font",
              "fontSize": 18,
              "fontWeight": "normal",
              "fontStyle": "italic"
            },
            {
              "type": "frame",
              "id": "LAg9M",
              "x": 64,
              "y": 418,
              "name": "Story",
              "width": 580,
              "layout": "vertical",
              "gap": 18,
              "children": [
                {
                  "type": "text",
                  "id": "vzPqv",
                  "name": "Paragraph",
                  "fill": "$inv-text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "We started our journey in 2015 when we organized a game development incubator, where we trained and supported young developers, helping them to bring their ideas to life. Since then we have grown to become Gdhub - a unique platform that brings together experienced professionals from different areas of game development into dynamic and creative teams.",
                  "lineHeight": 1.5,
                  "textAlign": "justify",
                  "fontFamily": "$font",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "BuyWs",
                  "name": "Paragraph",
                  "fill": "$inv-text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "On Gdhub you can find partners to co-develop commercial video games, as well as share knowledge and experience with other members of the community.",
                  "lineHeight": 1.5,
                  "textAlign": "justify",
                  "fontFamily": "$font",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Io6Ee",
                  "name": "Paragraph",
                  "fill": "$inv-text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "We work in a gig economy - an economy of temporary and non-permanent work, which gives us flexibility and independence. We value freedom, creativity and the ability to choose interesting projects.",
                  "lineHeight": 1.5,
                  "textAlign": "justify",
                  "fontFamily": "$font",
                  "fontSize": 18,
                  "fontWeight": "normal"
                }
              ]
            },
