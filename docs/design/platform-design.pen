                  "name": "Cap",
                  "fill": "$text-secondary",
                  "content": "5 · THE VERDICT REASONING — A PARAGRAPH THE CURATOR TYPES",
                  "fontFamily": "$font",
                  "fontSize": 11,
                  "fontWeight": "600",
                  "letterSpacing": 0.6
                },
                {
                  "type": "frame",
                  "id": "L1mR2",
                  "name": "Area",
                  "clip": true,
                  "width": "fill_container",
                  "height": 132,
                  "fill": "$border",
                  "cornerRadius": 10,
                  "padding": 12,
                  "children": [
                    {
                      "type": "text",
                      "id": "tFxvn",
                      "name": "V",
                      "fill": "$text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The outcome list is done bar the trailer, which you cut on day 14 with a reason I agree with. The walkthrough shows all three states with final art and a stranger finishing the run in 17 minutes, which is the outcome the whole checkpoint was built around. Take the save system into the demo stage as an input, not as work to redo, and start the next goal card from the",
                      "lineHeight": 1.5,
                      "fontFamily": "$font",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "Ng0em",
                  "name": "Rule",
                  "width": "fill_container",
                  "gap": 8,
                  "children": [
                    {
                      "type": "icon",
                      "id": "ChzBA",
                      "name": "Ic",
                      "width": 14,
                      "height": 14,
                      "icon": "corner-down-right",
                      "library": "lucide",
                      "fill": "$text-tertiary"
                    },
                    {
                      "type": "text",
                      "id": "Rlspi",
                      "name": "L",
                      "fill": "$text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The field grows to 132 and then scrolls; it never pushes the drawer's footer off screen. In the thread it is clamped to six lines with a Show all, because the entry above it is what the reader came for.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]
