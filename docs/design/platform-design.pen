                      "fill": "$text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "1. What this agreement covers",
                      "lineHeight": 1.3,
                      "fontFamily": "$font",
                      "fontSize": 24,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "a5jVEW",
                      "fill": "$text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "You advise teams on GDHub as a volunteer. Nothing here creates employment, a contractor relationship, a fee, equity or any other compensation.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "sC00K",
                      "fill": "$text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "2. Your time",
                      "lineHeight": 1.3,
                      "fontFamily": "$font",
                      "fontSize": 24,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "PZMiK",
                      "fill": "$text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "You choose which questions to take and can stop at any time. Nobody on the platform can oblige you to answer, meet a deadline or hold a call.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Oli6W",
                      "fill": "$text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "3. Confidentiality",
                      "lineHeight": 1.3,
                      "fontFamily": "$font",
                      "fontSize": 24,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "qkUhw",
                      "fill": "$text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "What a team shares with you in a request stays between you and them. You do not pass it on and you do not use it for a competing product.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "oNyVP",
                      "fill": "$text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "4. No warranty",
                      "lineHeight": 1.3,
                      "fontFamily": "$font",
                      "fontSize": 24,
                      "fontWeight": "600"
                    },
