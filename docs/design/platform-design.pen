    {
      "type": "note",
      "id": "cuh4P",
      "x": -420,
      "y": 0,
      "name": "Row — 00 · Design System",
      "width": 300,
      "height": 320,
      "content": "Design System\n\nSource of truth for tokens, typography and cards. To the right: shared components reused across all contexts (space bar — breadcrumbs & switcher, multiselect dropdowns)."
    },
    {
      "type": "note",
      "id": "qB2fp",
      "x": -420,
      "y": 6773,
      "name": "Row — 01 · Landing",
      "width": 300,
      "height": 320,
      "content": "Landing\n\nPublic promo landing page. Desktop and mobile variant stacked."
    },
    {
      "type": "note",
      "id": "UWyQr",
      "x": -420,
      "y": 19184,
      "name": "Row — 03 · Hub — Catalogs",
      "width": 300,
      "height": 320,
      "content": "Hub — Catalogs\n\nPublic hub: projects, events, jobs, courses, talent pool. Mobile versions, skeletons and empty states are stacked below. Job Card component sits at the end of the row."
    },
    {
      "type": "note",
      "id": "Orl2o",
      "x": -420,
      "y": 23226,
      "name": "Row — 01 · Public Pages",
      "width": 300,
      "height": 320,
      "content": "Public Pages\n\nPublic detail pages: project, event, job, course, legal details and certificate verification. Mobile variants stacked below desktop. Main Footer component sits at the end of the row."
    },
    {
      "type": "note",
      "id": "MpQCk",
      "x": -420,
      "y": 28938,
      "name": "Row — 03 · People Cards",
      "width": 300,
      "height": 320,
      "content": "People Cards\n\nTalent and expert card modals plus popovers (project, certificate) and their variants."
    },
    {
      "type": "note",
      "id": "u2ybn",
      "x": -420,
      "y": 32298,
      "name": "Row — 04 · Project Space",
      "width": 300,
      "height": 320,
      "content": "Project Space\n\nProject workspace: project modal with all tabs (files, activities, reviews, workflow, team), workflow page and vacancy modals. Task Row component and its states sit at the end of the row."
    },
    {
      "type": "note",
      "id": "b8JhR",
      "x": -420,
      "y": 39066,
      "name": "Row — 05 · Course Space",
      "width": 300,
      "height": 320,
      "content": "Course Space\n\nCourse workspace: my courses, curriculum, cohorts, students, classroom, payments and settings. Related modals stacked under their pages."
    },
    {
      "type": "note",
      "id": "ufj7V",
      "x": -420,
      "y": 41316,
      "name": "Row — 09 · Scout Space",
      "width": 300,
      "height": 320,
      "content": "Scout Space\n\nScout workspace (paid users looking for early-stage games to invest in or publish): games and settings."
    },
    {
      "type": "note",
      "id": "flN9z",
      "x": -420,
      "y": 43116,
      "name": "Row — 06 · Event Space",
      "width": 300,
      "height": 320,
      "content": "Event Space\n\nEvent workspace: my events, schedule, content, members, settings per event type and schedule item modals."
    },
    {
      "type": "note",
      "id": "O9kFwC",
      "x": -420,
      "y": 45281,
      "name": "Row — 10 · Admin — Users & Roles",
      "width": 300,
      "height": 320,
      "content": "Admin — Users & Roles\n\nAdmin: users, roles, permissions and related modals, dialogs and popovers."
    },
    {
      "type": "note",
      "id": "DBqOp",
      "x": -420,
      "y": 47797,
      "name": "Row — 10 · Admin — Workflows",
      "width": 300,
      "height": 320,
      "content": "Admin — Workflows\n\nAdmin workflows: templates, project workflows, editors and step/task/reset modals."
    },
    {
      "type": "note",
      "id": "NLkjV",
      "x": -420,
      "y": 50530,
      "name": "Row — 02 · Auth & Registration",
      "width": 300,
      "height": 320,
      "content": "Auth & Registration\n\nSign in, registration and invites: all steps and error states. Flow map on the left; the shared Log out bar component sits under this note (used by 22 auth/onboarding screens)."
    },
    {
      "type": "note",
      "id": "gbbW1",
      "x": -420,
      "y": 51912,
      "name": "Row — 02 · Onboarding",
      "width": 300,
      "height": 320,
      "content": "Onboarding\n\nPost-registration onboarding: welcome, profile, speciality, interests, resources, completion and error."
    },
