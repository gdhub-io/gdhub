                {
                  "type": "text",
                  "id": "PYqkw",
                  "name": "Note",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": 1000,
                  "content": "The typeface is the least transferable thing in that screenshot. What actually makes it read expensive is structural, and all of it transfers: cards separated by fill instead of borders, tinted icon tiles, statuses as a dot and a word rather than coloured pills, empty states treated as designed screens, and headings that are genuinely large. The first of those revises what I proposed earlier — hairline borders were the fix for near-black borders, but dropping the page to a tint and letting white cards float is the better answer, and it removes the border question entirely.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
