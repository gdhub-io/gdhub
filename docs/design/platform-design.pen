                      "fontFamily": "$font",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "Ng0em",
                  "name": "Rule",
                  "width": "fill_container",
                  "gap": 8,
