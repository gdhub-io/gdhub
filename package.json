{
	"name": "gamelab",
	"version": "0.1.0",
	"private": true,
	"packageManager": "bun@1.2.19",
	"engines": {
		"node": ">=24.0.0",
		"bun": ">=1.2.0"
	},
	"scripts": {
		"dev": "next dev --turbopack",
		"dev:webpack": "next dev",
		"ngrok": "ngrok http 3100 --url=https://ddrynau.ngrok.app",
		"stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhooks",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"build": "next build --turbopack",
		"build:webpack": "next build",
		"prebuild": "bun run refresh-translations && bun run lint",
		"export": "next export",
		"start": "next start",
		"lint": "biome check --diagnostic-level=error ./src ./tests ./scripts",
		"type-check": "tsc --noEmit",
		"prepare": "husky install",
		"refresh-translations": "dotenv -- node scripts/import-translations.js",
		"db:generate": "dotenv -- gdhub-prisma generate",
		"db:status": "dotenv -- gdhub-prisma status",
		"db:deploy": "dotenv -- gdhub-prisma deploy",
		"db:seed": "dotenv -- gdhub-prisma seed",
		"test": "dotenv -- vitest --run",
		"test:watch": "dotenv -- vitest",
		"test:integration": "cross-env RUN_DOCKER_INTEGRATION_TESTS=1 dotenv -- vitest --run tests/docker-prisma.integration.test.ts",
		"test:e2e": "dotenv -e .env.test -- cross-env E2E_TEST_AUTH=1 CRON_SECRET=e2e-cron LLM_CASSETTES=auto PLAYWRIGHT_BASE_URL=http://localhost:3100 DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/gdhub_test playwright test",
		"test:e2e:smoke": "dotenv -e .env.test -- cross-env E2E_TEST_AUTH=1 CRON_SECRET=e2e-cron LLM_CASSETTES=auto PLAYWRIGHT_BASE_URL=http://localhost:3100 DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/gdhub_test playwright test --project=smoke",
		"test:e2e:checkpoints": "dotenv -e .env.test -- cross-env E2E_TEST_AUTH=1 CRON_SECRET=e2e-cron LLM_CASSETTES=auto PLAYWRIGHT_BASE_URL=http://localhost:3100 DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/gdhub_test playwright test --project=checkpoints --no-deps",
		"test:e2e:ui": "dotenv -e .env.test -- cross-env E2E_TEST_AUTH=1 CRON_SECRET=e2e-cron LLM_CASSETTES=auto PLAYWRIGHT_BASE_URL=http://localhost:3100 DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/gdhub_test playwright test --ui",
		"test:e2e:staging": "cross-env PLAYWRIGHT_BASE_URL=https://staging.example.com playwright test --no-deps",
		"test:announce": "dotenv -- node scripts/test-announce-channels.mjs",
		"queues:clean": "dotenv -- node scripts/clean-queues.mjs",
		"checkpoint:review": "dotenv -- bun run scripts/checkpoint-review.ts",
		"checkpoint:simulate": "dotenv -- bun run scripts/checkpoint-simulate.ts",
		"daily:webhook": "dotenv -- bun run scripts/daily-webhook.ts",
		"rbac:seed-matrix": "dotenv -- bun run scripts/rbac-seed-matrix.ts",
		"rbac:matrix-doc": "bun run scripts/rbac-matrix-doc.ts",
		"rbac:backfill": "dotenv -- bun run scripts/rbac-backfill.ts",
		"rbac:seed-matrix:staging": "dotenv -e .env.staging.local -- bun run scripts/rbac-seed-matrix.ts",
		"rbac:backfill:staging": "dotenv -e .env.staging.local -- bun run scripts/rbac-backfill.ts",
		"rbac:seed-matrix:prod": "dotenv -e .env.prod.local -- bun run scripts/rbac-seed-matrix.ts",
		"rbac:backfill:prod": "dotenv -e .env.prod.local -- bun run scripts/rbac-backfill.ts",
		"test-env": "bun run scripts/test-env.ts",
		"cassettes:prune": "bun run scripts/prune-cassettes.ts",
		"dev:test": "scripts/stand.sh dev",
		"stand:build": "scripts/stand.sh build",
		"stand:start": "scripts/stand.sh start",
		"dev:test:live": "scripts/stand.sh live"
	},
