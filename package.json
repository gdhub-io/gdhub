{
	"name": "gamelab",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=20.9.0"
	},
	"scripts": {
		"dev": "next dev --turbopack",
		"dev:webpack": "next dev",
		"build": "next build --turbopack",
		"build:webpack": "next build",
		"prebuild": "npm run refresh-translations && npm run lint",
		"export": "next export",
		"start": "next start",
		"lint": "biome check --diagnostic-level=error ./src",
		"type-check": "tsc --noEmit",
		"prepare": "husky install",
		"refresh-translations": "node import-translations.js",
		"db:generate": "gdhub-prisma generate --schema ./node_modules/@gdhub-io/gdhub-prisma/prisma/schema.prisma",
		"db:deploy": "gdhub-prisma deploy --schema ./node_modules/@gdhub-io/gdhub-prisma/prisma/schema.prisma",
		"db:seed": "gdhub-prisma seed --schema ./node_modules/@gdhub-io/gdhub-prisma/prisma/schema.prisma",
		"test": "dotenv vitest",
		"test:integration": "cross-env RUN_DOCKER_INTEGRATION_TESTS=1 dotenv -- vitest --run tests/docker-prisma.integration.test.ts",
		"test:e2e": "dotenv -e .env.test -- playwright test",
		"test:e2e:ui": "dotenv -e .env.test -- playwright test --ui",
		"test:e2e:staging": "cross-env PLAYWRIGHT_BASE_URL=https://staging.example.com playwright test"
	},
	"prisma": {
		"seed": "node ./node_modules/@gdhub-io/gdhub-prisma/dist/seed.js"
	},
