{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(bun install)",
      "Bash(bun run lint)",
      "Bash(bun run lint:*)",
      "Bash(bun run type-check)",
      "Bash(bun run test)",
      "Bash(bun run test:*)",
      "Bash(bun run build)",
      "Bash(bun run db:generate)",
      "Bash(bun run refresh-translations)",
      "Bash(bunx biome check:*)",
      "Bash(bunx biome format:*)",
      "Bash(bunx tsc --noEmit)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git stash list)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(echo:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pen)",
      "Edit(./**/*.pen)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited-file.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/lint-gate.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
