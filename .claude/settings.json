{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(yarn lint)",
      "Bash(yarn lint:*)",
      "Bash(yarn type-check)",
      "Bash(yarn test)",
      "Bash(yarn test:*)",
      "Bash(yarn build)",
      "Bash(yarn db:generate)",
      "Bash(yarn refresh-translations)",
      "Bash(npx biome check:*)",
      "Bash(npx biome format:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git stash list)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(echo:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pen)",
      "Edit(./**/*.pen)"
    ]
  }
}
