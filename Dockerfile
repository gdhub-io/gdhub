# Install dependencies only when needed
FROM node:16-alpine AS deps
RUN apk add --no-cache libc6-compat

WORKDIR /app
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile

# 2. Rebuild the source code only when needed
FROM deps AS builder
WORKDIR /app

ARG JWT_SECRET
ARG CSRF_SECRET
ARG NEXTAUTH_URL
ARG NEXTAUTH_SECRET
ARG BACKEND_KEY
ARG NEXT_PUBLIC_APP_URI
ARG NEXT_PUBLIC_AUTH_COOKIE_NAME
ARG AIRTABLE_API_KEY
ARG AIRTABLE_BASE_ID
ARG GOOGLE_OAUTH_CLIENT_ID
ARG GOOGLE_OAUTH_CLEINT_SECRET
ARG NOTION_TOKEN
ARG NOTION_DATABASE_DOCS
ARG TELEGRAM_BOT_TOKEN
ARG TELEGRAM_CHAT_ID
ARG TELEGRAM_DISABLE_NOTIFICATIONS
ARG TELEGRAM_TOPIC_NEWS
ARG TELEGRAM_TOPIC_VACANCIES
ARG TELEGRAM_TOPIC_REPORTS
ARG SANITY_PROJECT_ID
ARG SANITY_DATASET
ARG SANITY_TOKEN
ARG DAILY_API_KEY
ARG NOVU_API_SECRET
ARG NOVU_CLIENT_APP_ID
ARG NEXT_PUBLIC_NOVU_CLIENT_APP_ID
ARG MAILGUN_API_KEY
ARG TYPESENSE_ADMIN_API
ARG NEXT_PUBLIC_TYPESENSE_SEARCH_API
ARG NEXT_PUBLIC_TYPESENSE_HOST
ARG NEXT_PUBLIC_TYPESENSE_PORT
ARG NEXT_PUBLIC_TYPESENSE_PROTOCOL

ENV JWT_SECRET=${JWT_SECRET}
ENV CSRF_SECRET=${CSRF_SECRET}
ENV NEXTAUTH_URL=${NEXTAUTH_URL}
ENV NEXTAUTH_SECRET=${NEXTAUTH_SECRET}
ENV BACKEND_KEY=${BACKEND_KEY}
ENV NEXT_PUBLIC_APP_URI=${NEXT_PUBLIC_APP_URI}
ENV NEXT_PUBLIC_AUTH_COOKIE_NAME=${NEXT_PUBLIC_AUTH_COOKIE_NAME}
ENV AIRTABLE_API_KEY=${AIRTABLE_API_KEY}
ENV AIRTABLE_BASE_ID=${AIRTABLE_BASE_ID}
ENV GOOGLE_OAUTH_CLIENT_ID=${GOOGLE_OAUTH_CLIENT_ID}
ENV GOOGLE_OAUTH_CLEINT_SECRET=${GOOGLE_OAUTH_CLEINT_SECRET}
ENV NOTION_TOKEN=${NOTION_TOKEN}
ENV NOTION_DATABASE_DOCS=${NOTION_DATABASE_DOCS}
ENV TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
ENV TELEGRAM_CHAT_ID=${TELEGRAM_CHAT_ID}
ENV TELEGRAM_DISABLE_NOTIFICATIONS=${TELEGRAM_DISABLE_NOTIFICATIONS}
ENV TELEGRAM_TOPIC_NEWS=${TELEGRAM_TOPIC_NEWS}
ENV TELEGRAM_TOPIC_VACANCIES=${TELEGRAM_TOPIC_VACANCIES}
ENV TELEGRAM_TOPIC_REPORTS=${TELEGRAM_TOPIC_REPORTS}
ENV SANITY_PROJECT_ID=${SANITY_PROJECT_ID}
ENV SANITY_DATASET=${SANITY_DATASET}
ENV SANITY_TOKEN=${SANITY_TOKEN}
ENV DAILY_API_KEY=${DAILY_API_KEY}
ENV NOVU_API_SECRET=${NOVU_API_SECRET}
ENV NOVU_CLIENT_APP_ID=${NOVU_CLIENT_APP_ID}
ENV NEXT_PUBLIC_NOVU_CLIENT_APP_ID=${NEXT_PUBLIC_NOVU_CLIENT_APP_ID}
ENV MAILGUN_API_KEY=${MAILGUN_API_KEY}
ENV TYPESENSE_ADMIN_API=${TYPESENSE_ADMIN_API}
ENV NEXT_PUBLIC_TYPESENSE_SEARCH_API=${NEXT_PUBLIC_TYPESENSE_SEARCH_API}
ENV NEXT_PUBLIC_TYPESENSE_HOST=${NEXT_PUBLIC_TYPESENSE_HOST}
ENV NEXT_PUBLIC_TYPESENSE_PORT=${NEXT_PUBLIC_TYPESENSE_PORT}
ENV NEXT_PUBLIC_TYPESENSE_PROTOCOL=${NEXT_PUBLIC_TYPESENSE_PROTOCOL}

COPY . .
RUN yarn build

# 3. Production image, copy all the files and run next
FROM node:16-alpine AS runner
WORKDIR /app

ENV NODE_ENV production
ENV NEXT_TELEMETRY_DISABLED 1

RUN addgroup -g 1001 -S nodejs
RUN adduser -S nextjs -u 1001

COPY --from=builder /app/next.config.js ./
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/public ./public/
COPY --chown=nextjs:nodejs --from=builder /app/.next/standalone ./
COPY --chown=nextjs:nodejs --from=builder /app/.next/static ./.next/static

USER nextjs

CMD node server.js