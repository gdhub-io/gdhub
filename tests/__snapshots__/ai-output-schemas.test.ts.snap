exports[`AI output schemas > review letter 1`] = `
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "agreed": {
      "description": "The focus for the next sprint, two or three lines that agree with the review and with any advice on the tasks; dueDay stays null. Empty on the final review.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "dueDay": {
            "anyOf": [
              {
                "type": "integer",
              },
              {
                "type": "null",
              },
            ],
          },
          "itemId": {
            "type": [
              "string",
              "null",
            ],
          },
          "text": {
            "type": "string",
          },
        },
        "required": [
          "text",
          "itemId",
          "dueDay",
        ],
        "type": "object",
      },
      "type": "array",
    },
    "message": {
      "description": "A letter to the team, three or four sentences, built from the review: where the team stands in plain words — on course, at risk or behind; what went well, or, when nothing was shown, that it is unknown what got done because nothing was shown; what worries you; and one thing to do next. On the final review, the whole road instead — four to six sentences that agree with the verdict and say what the next checkpoint starts from.",
      "type": "string",
    },
  },
  "required": [
    "message",
    "agreed",
  ],
  "type": "object",
}
`;

