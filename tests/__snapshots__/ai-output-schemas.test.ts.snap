exports[`AI output schemas > curator character sheet 1`] = `
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "name": {
      "description": "A short invented name with a title, as in the base role",
      "maxLength": 40,
      "type": "string",
    },
    "nameRu": {
      "description": "The same name in Russian: the title translated, the name itself transliterated, never translated word by word",
      "maxLength": 40,
      "type": "string",
    },
    "road": {
      "description": "The journey from point A to point B in that world, and its dangers",
      "maxLength": 280,
      "type": "string",
    },
    "who": {
      "description": "Who the character is, in one line, as the base role says it",
      "maxLength": 200,
      "type": "string",
    },
    "world": {
      "description": "Images from the character's world, a comma-separated list",
      "maxLength": 240,
      "type": "string",
    },
  },
  "required": [
    "name",
    "nameRu",
    "who",
    "world",
    "road",
  ],
  "type": "object",
}
`;

