exports[`AI output schemas > evidence judge 1`] = `
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "match": {
      "description": "Matches: it shows all of what the task promised. Partly: some of it — fewer of something than the task counts (players, levels, sheets) is Partly, whatever the evidence claims of itself. DoesNotMatch: it shows something else. CannotTell: too little was readable to say.",
      "enum": [
        "Matches",
        "Partly",
        "DoesNotMatch",
        "CannotTell",
      ],
      "type": "string",
    },
    "note": {
      "description": "One or two sentences: what you saw, and how it relates to the task.",
      "type": "string",
    },
  },
  "required": [
    "match",
    "note",
  ],
  "type": "object",
}
`;

exports[`AI output schemas > plan advice 1`] = `
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "add": {
      "description": "Up to three tasks worth adding, each ending in something anyone can open. Empty when nothing is missing.",
      "items": {
        "type": "string",
      },
      "type": "array",
    },
    "goal": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "fit": {
              "enum": [
                "fits",
                "widen",
                "narrow",
              ],
              "type": "string",
            },
            "note": {
              "description": "One or two sentences: why, and for widen or narrow the goal reworded, ready to use.",
              "type": "string",
            },
            "stage": {
              "additionalProperties": false,
              "description": "Whether the goal sits inside the stage goal. It may stop short of the stage goal; it is outside only when it reaches past it or points somewhere else.",
              "properties": {
                "inside": {
                  "type": "boolean",
                },
                "note": {
                  "description": "One or two sentences: for outside, what lies beyond the stage and what the stage ends with; the author may keep the goal, so say that the 28 days will be judged against it. Empty for inside.",
                  "type": "string",
                },
              },
              "required": [
                "inside",
                "note",
              ],
              "type": "object",
            },
          },
          "required": [
            "fit",
            "note",
            "stage",
          ],
          "type": "object",
        },
        {
          "type": "null",
        },
      ],
      "description": "Day 1 only, null halfway: does the goal as it stands now fit these tasks and 28 days of this team's hours — fits, widen (asks too little), narrow (outruns them).",
    },
    "message": {
      "description": "Day 1: a short letter to the team, three or four sentences, about the tasks as a whole and what to do now. Null halfway: that day's sprint review is the letter.",
      "type": [
        "string",
        "null",
      ],
    },
    "tasks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "itemId": {
            "type": "string",
          },
          "kind": {
            "description": "clear: checkable and fits; risky: may not fit the time left; vague: nobody could check it is done; shorten: keep it smaller; cut: drop it; onTrack: going as planned; offGoal: done or not, it would not bring the goal closer — the note says what the task would have to become to serve it.",
            "enum": [
              "clear",
              "risky",
              "vague",
              "shorten",
              "cut",
              "onTrack",
              "offGoal",
            ],
            "type": "string",
          },
          "note": {
            "description": "One sentence the author acts on: what to do with the task, then why — "Drop it: …", "Keep it: …", "Move it to sprint 3: …". There are no buttons; this sentence is the whole advice.",
            "type": "string",
          },
          "suggestion": {
            "description": "For vague and shorten: the task reworded, ready to use. Null otherwise.",
            "type": [
              "string",
              "null",
            ],
          },
        },
        "required": [
          "itemId",
          "kind",
          "note",
          "suggestion",
        ],
        "type": "object",
      },
      "type": "array",
    },
  },
  "required": [
    "message",
    "tasks",
    "add",
    "goal",
  ],
  "type": "object",
}
`;

