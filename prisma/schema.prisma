generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("POSTGRES_PRISMA_URL")
  directUrl         = env("POSTGRES_URL_NON_POOLING")
  shadowDatabaseUrl = env("POSTGRES_SHADOW_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Registration {
  id                String   @id @default(cuid())
  registrationToken String   @unique
  signature         String
  expires           DateTime
  createdAt         DateTime @default(now())
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String?             @unique
  emailVerified      DateTime?
  image              String?
  onboardingDone     Boolean             @default(false)
  createdAt          DateTime            @default(now())
  roles              UserRole[]          @default([Guest])
  updatedAt          DateTime            @updatedAt
  agreements         Json?               @default("{ \"confirmUserData\": false, \"agreeWithTermsAndPrivacy\": false, \"needSubscribeToNewsletter\": false }")
  lang               Language            @default(ru)
  accounts           Account[]
  requestedLectures  Lecture[]           @relation("requestedBy")
  listener           LectureListener[]
  profile            Profile?
  projects           Project[]
  projectEstimations ProjectEstimation[]
  projectReports     ProjectReport[]
  sessions           Session[]
  specialities       Speciality[]
  memberInTeams      TeamMember[]
  lecturerRequests   LecturerRequest[]
}

model Profile {
  id                String                @id @default(cuid())
  userId            String                @unique
  tgNickname        String?
  country           String?
  city              String?
  yearOfBirth       Int                   @default(0)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  timeForWork       Int[]
  name              String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredLevels   GameDifficultyLevel[] @relation("GameDifficultyLevelToProfile")
  preferredGenres   GameGenre[]           @relation("GameGenreToProfile")
  preferredSettings GameSetting[]         @relation("GameSettingToProfile")
  primaryInterest   PrimaryInterest       @default(Specialist)
  isActive          Boolean               @default(true)
  otherResources    String?
  motivation        String?
}

enum Language {
  ru
  en
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Speciality {
  id                String                         @id @default(cuid())
  name              String
  summary           String?
  specialization    String
  level             SkillLevel
  workDirectionId   String
  portfolioUrl      String?
  skills            String?
  tools             String?
  jobs              String?
  schools           String?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  userId            String
  user              User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction         WorkDirection                  @relation(fields: [workDirectionId], references: [id])
  teamMembers       TeamMember[]
  availableProjects MatchingSpecialistAndProject[]
}

model MatchingSpecialistAndProject {
  id           String     @id @default(cuid())
  specialityId String
  projectId    String
  projectScore Int
  authorScore  Int
  avgScore     Int
  teamScore    Int
  summary      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  specialist   Speciality @relation(fields: [specialityId], references: [id], onDelete: Cascade)
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, specialityId], name: "projectAndSpecialist")
}

model WorkDirection {
  id           String        @id @default(cuid())
  name         String        @unique
  Lecture      Lecture[]
  specialities Speciality[]
  vacancies    TeamVacancy[]
}

model GameGenre {
  id      String    @id @default(cuid())
  name    String    @unique
  Profile Profile[] @relation("GameGenreToProfile")
}

model GameSetting {
  id      String    @id @default(cuid())
  name    String    @unique
  Profile Profile[] @relation("GameSettingToProfile")
}

model GameDifficultyLevel {
  id      String    @id @default(cuid())
  name    String    @unique
  Profile Profile[] @relation("GameDifficultyLevelToProfile")
}

model Season {
  id          String        @id @default(cuid())
  name        String
  description String?
  startedAt   DateTime
  finishedAt  DateTime?
  status      SeasonStatus  @default(Planning)
  slug        String        @unique
  coverImage  String?
  stages      SeasonStage[]
}

model SeasonStage {
  id            String               @id @default(cuid())
  name          String
  description   String?
  startedAt     DateTime?
  finishedAt    DateTime?
  order         Int                  @default(0)
  isCurrent     Boolean              @default(false)
  seasonId      String
  projects      Project[]
  estimations   ProjectEstimation[]
  season        Season               @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  streamReports SeasonStreamReport[]
}

model SeasonStreamReport {
  id      String      @id @default(cuid())
  date    DateTime
  stageId String
  stage   SeasonStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
}

model Project {
  id                   String                         @id @default(cuid())
  name                 String
  description          String?
  status               ProjectStatus                  @default(Registered)
  startedAt            DateTime                       @default(now())
  finishedAt           DateTime?
  stageId              String
  authorId             String
  coverImage           String?
  genre                String
  platform             String
  setting              String
  visualStyle          String
  slug                 String                         @default(cuid())
  audition             String?
  conceptLink          String?
  gddLink              String?
  pitchdeckLink        String?
  videoLink            String?
  coreMechanics        String[]
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  teamId               String
  author               User                           @relation(fields: [authorId], references: [id])
  stage                SeasonStage                    @relation(fields: [stageId], references: [id])
  team                 Team                           @relation(fields: [teamId], references: [id])
  estimations          ProjectEstimation[]
  reports              ProjectReport[]
  vacancies            TeamVacancy[]
  availableSpecialists MatchingSpecialistAndProject[]
}

model ProjectEstimation {
  id         String      @id @default(cuid())
  projectId  String
  stageId    String
  expertId   String
  notes      String
  isApproved Boolean
  data       Json
  expert     User        @relation(fields: [expertId], references: [id])
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage      SeasonStage @relation(fields: [stageId], references: [id])
}

model Team {
  id        String        @id @default(cuid())
  name      String        @unique
  slug      String        @unique @default(cuid())
  projects  Project[]
  members   TeamMember[]
  vacancies TeamVacancy[]
}

model ProjectReport {
  id          String   @id @default(cuid())
  projectId   String
  publishedAt DateTime
  content     String
  video       String?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model TeamMember {
  id              String           @id @default(cuid())
  userId          String
  teamId          String
  startedAt       DateTime?
  finishedAt      DateTime?
  status          TeamMemberStatus @default(Applicant)
  position        String?
  allowedContacts String[]
  specialityId    String
  speciality      Speciality       @relation(fields: [specialityId], references: [id])
  vacancyId       String?
  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id])
  vacancy         TeamVacancy?     @relation(fields: [vacancyId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
}

model TeamVacancy {
  id          String            @id @default(cuid())
  title       String
  description String
  directionId String
  status      TeamVacancyStatus @default(Draft)
  publishedAt DateTime?
  finishedAt  DateTime
  closedAt    DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  teamId      String
  applicants  TeamMember[]
  direction   WorkDirection     @relation(fields: [directionId], references: [id])
  team        Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Lecture {
  id               String            @id @default(cuid())
  name             String
  wishes           String?
  requestedById    String?
  // lecturerId         String?
  // lecturer           LecturerRequest?  @relation(name: "selectedLecturer", fields: [lecturerId], references: [id], onDelete: Cascade)
  directionId      String
  description      String?
  date             DateTime?
  linkToStream     String?
  recordLink       String?
  duration         Int?
  isArchived       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  stage            LectureStage
  requestedBy      User?             @relation("requestedBy", fields: [requestedById], references: [id])
  direction        WorkDirection     @relation(fields: [directionId], references: [id])
  listeners        LectureListener[]
  lecturerRequests LecturerRequest[]
}

model LecturerRequest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  directionId  String
  curriculum   String    @db.Text
  date         DateTime?
  duration     Int?
  lectureId    String
  linkToStream String?
  isSpeaker    Boolean   @default(false)
  lecture      Lecture   @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
}

model LectureListener {
  id        String   @id @default(cuid())
  userId    String
  lectureId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lecture   Lecture  @relation(fields: [lectureId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

enum UserRole {
  Guest
  Member
  Author
  Mentor
  Admin
}

enum SkillLevel {
  Novice
  Beginner
  Skillful
  Experienced
  Expert
}

enum ProjectStatus {
  Registered
  Approved
  Rejected
  Done
}

enum TeamMemberStatus {
  Applicant
  Hired
  Rejected
  Fired
  Founder
}

enum TeamVacancyStatus {
  Draft
  Published
  Closed
}

enum LectureStage {
  Requested
  Proposed
  Actualized
  Ready
  Held
  Canceled
}

enum SeasonStatus {
  Planning
  Active
  Done
}

enum PrimaryInterest {
  Specialist
  Author
  Mentor
}
