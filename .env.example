# GDHub environment variables.
#
# Every variable here is read by the app. Each one is marked:
#   [required] — the feature behind it fails without a value (env() throws or
#                the provider rejects the call); a whole block marked required
#                means every variable in it is.
#   [optional] — has a default, or the feature is skipped when it is empty.
#
# FRONTEND: NEXT_PUBLIC_* variables are inlined into the browser bundle at
# build time — changing one needs a rebuild, and anything put here is public.
# BACKEND: everything else is read only on the server.

# =============================================================================
# FRONTEND (browser)
# =============================================================================

# --- App ----------------------------------------------------------------------
# [optional] Absolute base URL for links back into the app (Stripe return
# addresses among them). Falls back to NEXTAUTH_URL. Also read on the server.
NEXT_PUBLIC_APP_URL=
# [optional] "en" or "ru"; unset uses the app's built-in default.
NEXT_PUBLIC_APP_DEFAULT_LOCALE=
# [optional] Max upload size for reports and devlog files, MB. Default 5.
NEXT_PUBLIC_UPLOAD_FILE_FOR_REPORT_MAX_SIZE=

# --- Tolgee (translations) — required -----------------------------------------
NEXT_PUBLIC_TOLGEE_API_URL=
NEXT_PUBLIC_TOLGEE_API_KEY=
NEXT_PUBLIC_TOLGEE_PROJECT_ID=
# [optional] "true" enables the in-context translation editor in dev.
# Requires the Tolgee server to allow your dev origin (CORS).
NEXT_PUBLIC_TOLGEE_IN_CONTEXT=

# --- Typesense (search) — required --------------------------------------------
# Host/port/protocol are also used by the server together with TYPESENSE_ADMIN_API.
NEXT_PUBLIC_TYPESENSE_HOST=
NEXT_PUBLIC_TYPESENSE_PORT=
NEXT_PUBLIC_TYPESENSE_PROTOCOL=
NEXT_PUBLIC_TYPESENSE_SPECIALISTS_SCHEMA=
# Search-only keys (never the admin key). The search adapter reads the first.
NEXT_PUBLIC_TYPESENSE_SEARCH_API=
# Server-only search key the hub members page signs its scoped keys with. Never ship it to the browser.
TYPESENSE_SEARCH_API_KEY=

# --- Novu (in-app notifications) — required -----------------------------------
NEXT_PUBLIC_NOVU_CLIENT_APP_ID=

# --- Matrix (chat) — required -------------------------------------------------
NEXT_PUBLIC_MATRIX_CHAT_BASE_URL=http://localhost:8008
NEXT_PUBLIC_MATRIX_CHAT_HOMESERVER_DOMAIN=

# --- Matrix push gateway (chat push notifications) — optional -----------------
NEXT_PUBLIC_MATRIX_PUSH_GATEWAY_URL=
NEXT_PUBLIC_MATRIX_PUSH_APP_ID=
# Default "GDHub Chat"
NEXT_PUBLIC_MATRIX_PUSH_APP_DISPLAY_NAME=
# Default "http"
NEXT_PUBLIC_MATRIX_PUSH_KIND=
# Default "event_id_only"
NEXT_PUBLIC_MATRIX_PUSH_FORMAT=

# --- Firebase (web push) — optional; the first four go together ---------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Paddle (vacancy listing checkout) ----------------------------------------
# [required]
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# [required] Real "pri_..." price id of the paid vacancy listing fee.
NEXT_PUBLIC_PADDLE_VACANCY_PRICE_ID=
# [optional] "production" or "sandbox"; unset follows NODE_ENV.
NEXT_PUBLIC_PADDLE_ENV=

# --- Analytics & social — optional --------------------------------------------
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=
# Telegram login widget on the profile "Connect" form.
NEXT_PUBLIC_TELEGRAM_BOT_NAME=

# =============================================================================
# BACKEND (server only)
# =============================================================================

# --- Database — required ------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gdhub
# [optional] Queries slower than this are logged, ms. Default 300.
DB_SLOW_QUERY_MS=
# [optional] "1" logs every query; on by default outside production, "0" silences it.
DB_QUERY_LOG=

# --- Auth & internal API — required -------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Has an insecure built-in default — must be set in every deployment.
JWT_SECRET=
# Tokens for calls between the app's own services and its API.
BACKEND_KEY=
# Read only on the server despite the prefix.
NEXT_PUBLIC_API_KEY=
# [optional] Default "token". Read only on the server despite the prefix.
NEXT_PUBLIC_AUTH_COOKIE_NAME=
# Vercel sends `Authorization: Bearer $CRON_SECRET` to every scheduled path.
# Generate with `openssl rand -hex 32`. Required in deployments.
CRON_SECRET=

# --- Google OAuth (sign-in) — required ----------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Email (magic-link sign-in, contact form) — required ----------------------
# SMTP URL, e.g. smtp://localhost:1025 for MailHog.
EMAIL_SERVER=
EMAIL_FROM=

# --- Redis (queues, cache) — required -----------------------------------------
REDIS_URL=redis://localhost:6379
# [optional] Daily run times of the queue jobs, "HH:MM". Defaults 00:00 / 06:00 / 12:00.
QUEUE_PROJECT_REPORTS_TIME=
QUEUE_SPECIALITIES_TIME=
QUEUE_VACANCIES_TIME=

# --- Sanity (file storage, image CDN) — required ------------------------------
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_TOKEN=

# --- Typesense (index sync) — required ----------------------------------------
TYPESENSE_ADMIN_API=

# --- Matrix (chat) — required -------------------------------------------------
MATRIX_CHAT_BASE_URL=http://localhost:8008
MATRIX_CHAT_HOMESERVER_DOMAIN=
MATRIX_CHAT_APPSERVICE_TOKEN=
MATRIX_CHAT_SYNAPSE_ADMIN_TOKEN=

# --- Novu (notifications) -----------------------------------------------------
# [required]
NOVU_API_SECRET=
# [optional] Default https://api.novu.co
NOVU_API_URL=
# [optional] Dev only: "1" sends every Novu trigger as a plain email to EMAIL_SERVER (MailHog).
NOVU_LOCAL_MAIL=

# --- Brevo (newsletter contacts) ----------------------------------------------
# [required]
BREVO_API_KEY=
# [optional] Default 2.
BREVO_SUBSCRIBERS_LIST_ID=
# [optional] "1" lets the sync write to Brevo; anything else is a dry run.
BREVO_SYNC_ALLOW_WRITE=0

# --- OpenAI (AI curator, AI validation) ---------------------------------------
# [required]
OPENAI_API_KEY=
# [optional] Default gpt-4o-mini.
OPENAI_API_MODEL=
# [optional] Model of the checkpoint AI curator; unset uses the one in config.
CHECKPOINT_CURATOR_MODEL=
# [optional] "false" turns AI field validation off. Default on.
AI_VALIDATION_ENABLED=
# [optional] Default omni-moderation-latest.
AI_VALIDATION_MODERATION_MODEL=
# [optional] Unset falls back to OPENAI_API_MODEL.
AI_VALIDATION_RELEVANCE_MODEL=

# --- Paddle (vacancy listings, AI checkpoints) — required ---------------------
PADDLE_API_KEY=
# Notification destination secret, verifies webhook signatures.
PADDLE_WEBHOOK_SECRET=
# The AI Checkpoint price; sandbox and live have their own ids.
PADDLE_AI_CHECKPOINT_PRICE_ID=

# --- Stripe (checkpoints only; vacancy listings stay on Paddle) — required ----
STRIPE_SECRET_KEY=
# Signing secret of /api/stripe/webhooks. `stripe listen` prints one for local
# work; the signature is verified in every environment.
STRIPE_WEBHOOK_SECRET=
# [optional] "true" lets authors buy checkpoints. A project with a checkpoint
# already running is unaffected.
CHECKPOINTS_PURCHASE_OPEN=

# --- Daily (checkpoint video calls) — required --------------------------------
DAILY_API_KEY=
# The base64 secret the Daily webhook was registered with.
DAILY_WEBHOOK_SECRET=

# --- Access control — optional ------------------------------------------------
# "false" puts RBAC in shadow mode: denials are logged, not applied. Default enforcing.
# Ignored by production builds, which always enforce.
RBAC_ENFORCE=

# --- Telegram (announces, reports, vacancies) — optional ----------------------
# Without a token Telegram posts fail; the chat/topic ids are needed per post type.
TELEGRAM_BOT_TOKEN=
# "test" uses Telegram's test environment.
TELEGRAM_BOT_API_MODE=
# "1" sends posts silently.
TELEGRAM_DISABLE_NOTIFICATIONS=
# Russian-speaking community
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_NEWS=
TELEGRAM_TOPIC_VACANCIES=
TELEGRAM_TOPIC_REPORTS=
TELEGRAM_NEWS_CHANNEL_ID=
# English-speaking community
TELEGRAM_EN_CHAT_ID=
TELEGRAM_EN_TOPIC_NEWS=
TELEGRAM_EN_TOPIC_VACANCIES=
TELEGRAM_EN_TOPIC_REPORTS=
TELEGRAM_EN_NEWS_CHANNEL_ID=

# --- Discord (community announces) — optional, announces skip when empty ------
DISCORD_BOT_TOKEN=
DISCORD_NEWS_CHANNEL_ID=
# Project devlogs
DISCORD_PROJECT_NEWS_CHANNEL_ID=
# Used by scripts/test-announce-channels.mjs
DISCORD_TEST_CHANNEL_ID=

# --- LinkedIn (company-page announces) — optional, skipped when empty ---------
LINKEDIN_ACCESS_TOKEN=
# urn:li:organization:12345 or just 12345
LINKEDIN_ORG_URN=
# Default 202409
LINKEDIN_API_VERSION=
# Used to refresh the access token
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Legal document signing (Documenso) — optional ----------------------------
LEGAL_DOCUMENT_SIGNING_SERVER_URL=
LEGAL_DOCUMENT_SIGNING_AUTH_TOKEN=
LEGAL_DOCUMENT_SIGNING_EVENT_FOLDER_ID=

# --- LangGraph (Triangle Assistant, hidden) — optional ------------------------
# Default http://localhost:8123
LANGGRAPH_URL=
# Default "chat"
LANGGRAPH_CHAT_GRAPH=
LANGGRAPH_ASSISTANT_ID=

# --- Development & tests — optional, never set in a deployment ----------------
# Local sign-in as a fixture account: /dev-signin and the header's "Switch
# account" menu. Ignored when NODE_ENV=production. `bun run dev:test` sets it.
E2E_TEST_AUTH=
# "true" runs the Docker-backed Prisma integration tests.
RUN_DOCKER_INTEGRATION_TESTS=false
# Points Playwright at an app already running there instead of starting its own
# on http://localhost:3100.
PLAYWRIGHT_BASE_URL=
# Set by scripts/stand.sh for the e2e stand — leave unset here:
# NEXT_PUBLIC_E2E_STAND, NEXT_PUBLIC_DAILY_EMULATED, NEXT_PUBLIC_EXPERT_CHECKPOINT_OPEN,
# DAILY_EMULATED, LLM_CASSETTES, NEXT_DIST_DIR.
