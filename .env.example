# Server-side Environment Variables
CSRF_SECRET=
BACKEND_KEY=
NEXTAUTH_URL=
# Where the app answers, used to build absolute links back into it — Stripe's
# return addresses among them. Falls back to NEXTAUTH_URL when unset.
NEXT_PUBLIC_APP_URL=
NEXTAUTH_SECRET=
JWT_SECRET=

DB_SLOW_QUERY_MS=100
DB_QUERY_LOG=1

# GOOGLE OAUTH
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# GOOGLE ANALYTICS
GOOGLE_ANALYTICS_CLIENT_EMAIL=
GOOGLE_ANALYTICS_PRIVATE_KEY=
GOOGLE_ANALYTICS_PROPERTY_ID=

# NOTION
NOTION_TOKEN=
NOTION_DATABASE_DOCS=
NOTION_GL_STAGES_DOCS=

# TELEGRAM
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DISABLE_NOTIFICATIONS=
TELEGRAM_TOPIC_NEWS=
TELEGRAM_TOPIC_VACANCIES=
TELEGRAM_TOPIC_REPORTS=

# SANITY
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_TOKEN=

# DAILY
DAILY_DOMAIN=
DAILY_API_KEY=

# NOVU
NOVU_API_SECRET=
NOVU_CLIENT_APP_ID=

# Discord (community announces; safe to leave empty — announces just skip)
DISCORD_BOT_TOKEN=
DISCORD_NEWS_CHANNEL_ID=
DISCORD_TEST_CHANNEL_ID= # for testing announces
DISCORD_PROJECT_NEWS_CHANNEL_ID= # for project dev logs

# LinkedIn company-page announces (leave empty to skip)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_ORG_URN=           # urn:li:organization:12345  или просто 12345
LINKEDIN_API_VERSION=       # optional, default 202409
LINKEDIN_CLIENT_ID=         # for refresh token
LINKEDIN_CLIENT_SECRET=     # for refresh token

# BREVO
BREVO_API_KEY=
BREVO_SUBSCRIBERS_LIST_ID=
BREVO_SYNC_ALLOW_WRITE=0
EMAIL_SERVER=
EMAIL_FROM=

# TYPESENSE
TYPESENSE_ADMIN_API=

# POSTGRES
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

MATRIX_CHAT_BASE_URL=http://localhost:8008
MATRIX_CHAT_APPSERVICE_TOKEN=
MATRIX_CHAT_SYNAPSE_ADMIN_TOKEN=
MATRIX_CHAT_HOMESERVER_DOMAIN=


# Vercel sends `Authorization: Bearer $CRON_SECRET` to every scheduled path once
# this is set on the project. Generate with `openssl rand -hex 32`.
CRON_SECRET=

# Client-side Environment Variables
NEXT_PUBLIC_API_KEY=
NEXT_PUBLIC_APP_DEFAULT_LOCALE=
NEXT_PUBLIC_AUTH_COOKIE_NAME=
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=
NEXT_PUBLIC_NOVU_CLIENT_APP_ID=

# TYPESENSE
NEXT_PUBLIC_TYPESENSE_SPECIALISTS_SCHEMA=
NEXT_PUBLIC_TYPESENSE_SEARCH_API=
NEXT_PUBLIC_TYPESENSE_HOST=
NEXT_PUBLIC_TYPESENSE_PORT=
NEXT_PUBLIC_TYPESENSE_PROTOCOL=

# TOLGEE
NEXT_PUBLIC_TOLGEE_API_KEY=
NEXT_PUBLIC_TOLGEE_API_URL=
NEXT_PUBLIC_TOLGEE_PROJECT_ID=
# Set to "true" to enable the in-context translation editor in dev.
# Requires the Tolgee server to allow your dev origin (CORS).
NEXT_PUBLIC_TOLGEE_IN_CONTEXT=

OPENAI_API_KEY=
OPENAI_API_MODEL=gpt-5-mini

# Integration tests
RUN_DOCKER_INTEGRATION_TESTS=false

# Paddle
PADDLE_API_KEY=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Real "pri_..." price id for the paid vacancy listing fee (from Paddle dashboard)
NEXT_PUBLIC_PADDLE_VACANCY_PRICE_ID=
# Notification destination secret key — used to verify webhook signatures
PADDLE_WEBHOOK_SECRET=

# Stripe — checkpoints only; vacancy listings stay on Paddle above
STRIPE_SECRET_KEY=
# Signing secret of the /api/stripe/webhooks endpoint. `stripe listen` prints one
# for local work; the signature is verified in every environment.
STRIPE_WEBHOOK_SECRET=

AI_VALIDATION_ENABLED=1
AI_VALIDATION_MODERATION_MODEL=omni-moderation-latest
AI_VALIDATION_RELEVANCE_MODEL=gpt-4o-mini

# Local sign-in as a fixture account: /dev-signin and the header's "Switch
# account" menu. Ignored when NODE_ENV=production, so it can never reach a
# deployment. `bun run dev:test` sets it for the throwaway database.
E2E_TEST_AUTH=
