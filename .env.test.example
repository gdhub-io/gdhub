# Copy to .env.test and adjust. Loaded for `yarn test:e2e`.
# DO NOT use these values in production — they enable a backdoor sign-in.

# --- Test database (must be separate from your dev DB) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/gdhub_test

# --- Auth (any value, just must match between server boot and tests) ---
NEXTAUTH_SECRET=insecure-e2e-secret-please-replace-32chars
NEXTAUTH_URL=http://localhost:3000

# --- E2E backdoor ---
# Activates the gated `e2e-credentials` provider in src/auth.ts.
# Hard-gated behind NODE_ENV!=='production' so prod can never accept this.
E2E_TEST_AUTH=1

# --- Required for the app to boot, but unused by e2e flows ---
# Keep these dummy unless a specific test exercises them.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
EMAIL_FROM=test@gdhub.local
EMAIL_SERVER=smtp://localhost:1025

# DISABLE TOLGEE
NEXT_PUBLIC_TOLGEE_IN_CONTEXT=false
