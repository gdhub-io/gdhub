{
	"$schema": "https://docs.tolgee.io/cli-schema.json",
	"apiUrl": "https://tolgee.gdhub.io",
	"patterns": ["./src/**/*.{ts,tsx}"],
	"parser": "react",
	"strictNamespace": false,
	"format": "JSON_TOLGEE",
	"push": {
		"files": [
			{ "path": "./src/i18n/en.json", "language": "en" },
			{ "path": "./src/i18n/ru.json", "language": "ru" }
		]
	},
	"pull": {
		"path": "./src/i18n"
	}
}
