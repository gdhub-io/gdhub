# Environment file for running the RBAC scripts against a deployed database.
#
#   cp .env.production.example .env.production   # same for .env.staging
#
# Both files are gitignored. They exist only to point a hand-run script at the
# right database — they are NOT the runtime configuration of the deployed app,
# which lives in the hosting provider's environment.
#
#   bun run rbac:backfill:prod -- --dry-run
#   bun run rbac:seed-matrix:prod
#
# The scripts print the host and database name they are about to touch as their
# first line of output. Read it before letting a write run.

# The only variable the RBAC scripts require.
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional. The backfill issues one query per membership; leave logging off or
# the report drowns in SQL. `0` disables it.
DB_QUERY_LOG=0

# ---------------------------------------------------------------------------
# NOT here — set these where the app actually runs, not in this file:
#
#   RBAC_ENFORCE   Shadow mode for the deployed app (`false` logs denials
#                  instead of applying them). The scripts never read it.
#   AUTH_SECRET, NEXTAUTH_URL, and everything else from .env.example.
# ---------------------------------------------------------------------------
